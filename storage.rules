rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth != null
        && firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid));
    }
    function account() {
      return firestore.get(/databases/(default)/documents/staff_accounts/$(request.auth.uid)).data;
    }
    function hasSection(sections) {
      return request.auth != null && account().status == 'approved'
        && account().get('memberId', '') != ''
        && account().get('dashboardSections', []).hasAny(sections);
    }
    function isApprovedMember(memberId) {
      return request.auth != null && account().status == 'approved'
        && account().get('memberId', '') == memberId;
    }
    function acceptableFile() {
      return request.resource.size <= 10 * 1024 * 1024
        && request.resource.contentType.matches('application/pdf|image/.*|application/octet-stream');
    }

    match /{allPaths=**} {
      allow read, write: if isAdmin();
    }
    match /staff-documents/{memberId}/{rest=**} {
      allow create: if isApprovedMember(memberId) && acceptableFile();
      allow read, write: if hasSection(['hr']);
    }
    match /staff-contracts/{memberId}/{rest=**} {
      allow read: if isApprovedMember(memberId);
      allow read, write: if hasSection(['hr']);
    }
    match /staff-docs/{rest=**} { allow read, write: if hasSection(['hr']); }
    match /staff-photos/{rest=**} { allow read, write: if hasSection(['hr']); }
    match /day-plans/{rest=**} { allow read, write: if hasSection(['dayPlans']); }
    match /transports/{rest=**} { allow read, write: if hasSection(['transport']); }
    match /justificatifs/{fileName} { allow read: if hasSection(['reservations']); }
    match /banqueimage/{rest=**} { allow read: if true; allow write: if hasSection(['media']); }
    match /banqueimage/dashboard-pages/{rest=**} { allow write: if hasSection(['pages', 'media']); }
    match /sejours/{rest=**} { allow read: if true; allow write: if hasSection(['stays']); }
    match /retours/{rest=**} { allow read: if true; allow write: if hasSection(['testimonials']); }
    match /medias/{rest=**} { allow read: if true; allow write: if hasSection(['media']); }
  }
}
