rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    function staffAccount() {
      return get(/databases/$(database)/documents/staff_accounts/$(request.auth.uid)).data;
    }
    function isApprovedStaff() {
      return signedIn()
        && exists(/databases/$(database)/documents/staff_accounts/$(request.auth.uid))
        && staffAccount().status == 'approved'
        && staffAccount().get('memberId', '') != '';
    }
    function hasSection(sections) {
      return isApprovedStaff() && staffAccount().get('dashboardSections', []).hasAny(sections);
    }
    function onlyChanges(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
    }
    function onlyArchiveChanges() {
      return hasSection(['archives'])
        && onlyChanges(['archived', 'season', 'archivedAt', 'archivedBy', 'restoredAt', 'restoredBy']);
    }
    function myConvoy() {
      return isApprovedStaff() && resource.data.staffMemberIds.hasAny([staffAccount().memberId]);
    }

    match /{document=**} {
      allow read, write: if isAdmin();
    }
    match /admins/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
    }
    match /staff_accounts/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.status == 'pending'
        && request.resource.data.get('memberId', '') == ''
        && !request.resource.data.keys().hasAny([
          'reviewedAt', 'reviewedBy', 'dashboardSections', 'dashboardReviewedAt', 'dashboardReviewedBy'
        ]);
      allow update: if signedIn() && request.auth.uid == uid
        && onlyChanges(['firstName', 'lastName', 'phone', 'requestedRole', 'updatedAt']);
    }
    match /staff_members/{id} {
      allow read: if hasSection(['hr', 'transport', 'dayPlans']);
      allow get: if isApprovedStaff() && staffAccount().memberId == id;
      allow create, delete: if hasSection(['hr']);
      allow update: if hasSection(['hr']) || (
        isApprovedStaff() && staffAccount().memberId == id
        && onlyChanges(['phone', 'address', 'dateOfBirth', 'birthPlace', 'nationality', 'updatedAt'])
      );
    }
    match /staff_contracts/{id} {
      allow read: if hasSection(['hr', 'transport', 'dayPlans', 'finance', 'archives', 'overview'])
        || (isApprovedStaff() && resource.data.memberId == staffAccount().memberId);
      allow create, update, delete: if hasSection(['hr']);
      allow update: if onlyArchiveChanges();
    }
    match /staff_documents/{id} {
      allow read: if hasSection(['hr']) || (isApprovedStaff() && resource.data.memberId == staffAccount().memberId);
      allow write: if hasSection(['hr']);
      allow create: if isApprovedStaff()
        && request.resource.data.memberId == staffAccount().memberId
        && request.resource.data.status == 'pending'
        && request.resource.data.locked == false;
    }
    match /staff_public_profiles/{id} { allow read, write: if hasSection(['hr']); }
    match /salary_grid/{id} { allow read, write: if hasSection(['hr']); }
    match /day_plans/{id} {
      allow read: if isApprovedStaff();
      allow write: if hasSection(['dayPlans']);
      allow update: if onlyArchiveChanges();
    }

    match /reservations/{id} {
      allow read: if hasSection(['reservations', 'finance', 'archives', 'overview', 'transport', 'communication']);
      allow create, update, delete: if hasSection(['reservations']);
      allow update: if onlyArchiveChanges();
      allow update: if hasSection(['communication']) && onlyChanges([
        'stripeDepositUrl', 'stripeBalanceUrl', 'payment', 'smsS4ReminderSent', 'smsS4ReminderSentAt',
        'smsS4ReminderRecipient', 'smsS4ReminderText'
      ]) && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['payment'])
        || request.resource.data.payment.diff(resource.data.get('payment', {})).affectedKeys().hasOnly([
          'failedPaymentRecoveryUrl', 'failedPaymentRecoveryInstallments', 'failedPaymentRecoveryCreatedAt'
        ]));
      allow update: if hasSection(['transport']) && onlyChanges([
        'legal', 'updatedAt', 'convocationSent', 'convocationSentAt', 'convocationReminderSentAt',
        'convocationReminderDoneAt', 'lastMinuteConvocationSentAt', 'lastMinuteConvocationTripId',
        'lastMinuteConvocationSubject'
      ]) && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['legal'])
        || request.resource.data.legal.diff(resource.data.get('legal', {})).affectedKeys().hasOnly([
          'email', 'emails', 'phone', 'phones'
        ]));

      match /activity/{eventId} {
        allow read: if hasSection(['reservations']);
        allow create: if hasSection(['reservations'])
          && get(/databases/$(database)/documents/reservations/$(id)).data.get('archived', false) != true
          && !(get(/databases/$(database)/documents/reservations/$(id)).data.get('status', '') in [
            'validated', 'validee', 'validée', 'confirmed', 'cancelled', 'deleted', 'annulee', 'annulée', 'supprimee', 'supprimée'
          ])
          && request.resource.data.keys().hasOnly(['type', 'summary', 'actorUid', 'actorEmail', 'createdAt'])
          && request.resource.data.type in ['call', 'manualEmail', 'note', 'price', 'status', 'followUp', 'assign']
          && request.resource.data.summary is string
          && request.resource.data.summary.size() > 0
          && request.resource.data.summary.size() <= 4000
          && request.resource.data.actorUid == request.auth.uid
          && request.resource.data.actorEmail == request.auth.token.email
          && request.resource.data.createdAt == request.time;
      }
    }
    match /transports/{id} {
      allow read: if hasSection(['reservations', 'transport', 'hr', 'finance', 'archives']) || myConvoy();
      allow write: if hasSection(['transport']);
      allow update: if onlyArchiveChanges()
        || (hasSection(['archives']) && onlyChanges(['archived', 'season', 'archivedAt', 'archivedBy', 'staffMemberIds']))
        || ((hasSection(['reservations']) || myConvoy()) && onlyChanges(['passengers', 'updatedAt']));
    }
    match /transport_rdv_points/{id} { allow read, write: if hasSection(['transport']); }
    match /transport_settings/{id} { allow read, write: if hasSection(['transport']); }

    match /finance_summaries/{id} {
      allow read: if hasSection(['finance', 'transport', 'production']);
      allow write: if hasSection(['finance']);
    }
    match /accounting_reports/{id} {
      allow read, write: if hasSection(['finance', 'production']);
    }
    match /accommodation_research/{id} { allow read, write: if hasSection(['accommodation']); }
    match /benevoles/{id} {
      allow create: if request.resource.data.status == 'new'
        && request.resource.data.keys().hasOnly(['firstName', 'lastName', 'phone', 'email', 'interests', 'availability', 'message', 'status', 'notes', 'source', 'createdAt', 'updatedAt']);
      allow read, update, delete: if hasSection(['volunteers']);
    }
    match /merch_orders/{id} { allow read, update: if hasSection(['merch']); }

    match /polls/{id} { allow read, write: if true; }
    match /ColoCrew/{id} { allow get: if true; }
    match /sejours/{id} {
      allow read: if true;
      allow write: if hasSection(['stays', 'production']);
    }
    match /pages/{id} { allow read: if true; allow write: if hasSection(['pages']); }
    match /retours/{id} { allow read: if true; allow write: if hasSection(['testimonials']); }
    match /seasons/{id} { allow read: if true; allow write: if hasSection(['archives']); }
    match /blog/{id} { allow read: if true; allow write: if hasSection(['blog']); }
    match /blogPosts/{id} { allow read: if true; allow write: if hasSection(['blog']); }
    match /temoignages/{id} { allow read: if true; allow write: if hasSection(['testimonials']); }
    match /photos/{id} { allow read: if true; allow write: if hasSection(['media', 'pages', 'testimonials']); }
    match /albums/{id} { allow read: if true; allow write: if hasSection(['media']); }
    match /medias/{id} { allow read: if true; allow write: if hasSection(['media']); }
  }
}
