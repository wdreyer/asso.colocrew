# Firebase config (Console Firebase > Project settings > General > Your apps)
# Next.js (utilisé dans ce projet)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_DASHBOARD_NAMESPACE=draft

# Sécurise les tâches automatiques (ex: rappel J-7 des convocations)
CRON_SECRET=

# Brevo (anciennement Sendinblue) — clé API v3
# Dashboard > Mon compte > Clés API > Générer une clé
BREVO_API_KEY=

# Compat Vite (conservé pour scripts/outils éventuels)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
